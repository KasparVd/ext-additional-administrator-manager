/**
 * Setup page for invited administrators, rendered by Modules_AdditionalAdministratorManager_SetupPage.
 *
 * @var callable    $e              HTML escaper
 * @var callable    $lmsg           Locale message in the page's language
 * @var callable    $t              Escaped locale message
 * @var string      $lang           Language code of the page's texts
 * @var string      $assets         URL of htdocs/public/
 * @var string      $logoUrl        URL of the server's custom logo, or of the Plesk logo
 * @var bool        $invalid        True if the token is missing, unknown or expired
 *
 * Only for a valid link:
 * @var string      $token          The invitation token from the link
 * @var string      $username       Value of the username field
 * @var array       $errors         Error messages keyed by field name
 * @var string|null $passwordPolicy Minimum password strength as server_pref reports it
 * @var int|null    $minimumLevel   The same as a meter level (0-4)
 */
$fieldClass = function ($name) use (&$errors) {
    return 'pul-form-field' . (isset($errors[$name]) ? ' pul-form-field--error' : '');
};
$helpLink = function () use ($e, $t) {
    $url = Modules_AdditionalAdministratorManager_Settings::helpArticle();
    if ($url === '') {
        return '';
    }
    return '<p class="aam-help"><span class="pul-action pul-action--size-16"><a href="' . $e($url) . '" target="_blank" rel="noopener noreferrer" class="pul-action__content">'
        . '<span class="pul-icon pul-icon--size-16 pul-action__icon" aria-hidden="true"><svg focusable="false"><use href="/ui-library/images/symbols.svg#question-mark-circle:16"></use></svg></span>'
        . $t('setupHelp') . '</a></span></p>';
};
$fieldError = function ($name) use (&$errors, $e) {
    return isset($errors[$name]) ? '<div class="pul-form-field__error" id="' . $e($name) . '-error">' . $e($errors[$name]) . '</div>' : '';
};
