// Settings for setup.js. A JSON data block, because the page's Content-Security-Policy allows no inline scripts.
// Texts under "plesk" are replaced by Plesk's own wording (loaded live from /cp/locale, in the page's language) when available.
$setupConfig = [
    'policy' => $passwordPolicy,
    'minimumLevel' => $minimumLevel,
    'estimateUrl' => '?auth=' . rawurlencode($token),
    'localeUrl' => '/cp/locale?sections%5B%5D=components.password&locale=' . rawurlencode($lang),
    'plesk' => [
        'meter.verdictVeryWeak' => $lmsg('meterVerdictVeryWeak'),
        'meter.verdictWeak' => $lmsg('meterVerdictWeak'),
        'meter.verdictMedium' => $lmsg('meterVerdictMedium'),
        'meter.verdictStrong' => $lmsg('meterVerdictStrong'),
        'meter.verdictVeryStrong' => $lmsg('meterVerdictVeryStrong'),
        'meter.description' => $lmsg('meterDescription'),
        'meter.yourPasswordIsStrong' => $lmsg('meterYourPasswordIsStrong'),
        'generator.generate' => $lmsg('buttonGeneratePassword'),
    ],
    'text' => [
        'showPassword' => $lmsg('labelShowPassword'),
        'hidePassword' => $lmsg('labelHidePassword'),
        'strengthIs' => $lmsg('meterStrengthIs'),
        'required' => $lmsg('meterRequired'),
        'close' => $lmsg('buttonClose'),
        'copied' => $lmsg('messagePasswordCopied'),
        'copyFailed' => $lmsg('errorPasswordCopy'),
        'tooWeak' => $lmsg('errorPasswordTooWeak'),
        'mismatch' => $lmsg('errorPasswordMismatch'),
    ],
];
?>
<script type="application/json" id="aam-setup-config"><?php echo json_encode($setupConfig, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT); ?></script>
